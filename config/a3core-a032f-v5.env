CONFIG_ENV=config/a3core-a032f-v5.env

KERNEL_SOURCE=https://github.com/IverCoder/android_kernel_samsung_a3core
KERNEL_SOURCE_BRANCH=stable
KERNEL_CONFIG=a3core_eur_open_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=a3core-sukisu-susfs
ADD_LOCALVERSION_TO_FILENAME=true

EXTRA_CMDS:BSP_BUILD_FAMILY=sharkl3 BSP_BUILD_DT_OVERLAY=y BSP_BUILD_ANDROID_OS=y
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu- LD=ld.lld HOSTLOADLIBES_dtc=-lyaml KCFLAGS=-Wno-error

CLANG_BRANCH=master-kernel-build-2021
CLANG_VERSION=r383902
USE_CUSTOM_CLANG=false
USE_LLVM=false

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=none

ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=kernel-4.14

ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=true
ENABLE_KPM=false

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=CONFIG_KSU_SUSFS=y CONFIG_KSU_SUSFS_SUS_PATH=y CONFIG_KSU_SUSFS_OPEN_REDIRECT=y CONFIG_KSU_SUSFS_SUS_MOUNT=y CONFIG_KSU_SUSFS_TRY_UMOUNT=y CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y CONFIG_KSU_SUSFS_SUS_OVERLAYFS=y CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y CONFIG_KSU_SUSFS_SUS_KSTAT=y CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y CONFIG_KSU_SUSFS_SPOOF_UNAME=y

USE_CUSTOM_ANYKERNEL3=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
