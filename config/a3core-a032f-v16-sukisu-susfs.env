CONFIG_ENV=config/a3core-a032f-v16-sukisu-susfs.env

KERNEL_SOURCE=https://github.com/IverCoder/android_kernel_samsung_a3core
KERNEL_SOURCE_BRANCH=stable
KERNEL_SOURCE_COMMIT=81da2968a777556d20847e30b618658905af67a3
KERNEL_CONFIG=a3core_eur_open_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=a3core-vendorabi-v16-sukisu-susfs
ADD_LOCALVERSION_TO_FILENAME=true

EXTRA_CMDS:BSP_BUILD_FAMILY=sharkl3 BSP_BUILD_DT_OVERLAY=y BSP_BUILD_ANDROID_OS=y
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu- LD=ld.lld HOSTLOADLIBES_dtc=-lyaml

CLANG_BRANCH=master-kernel-build-2021
CLANG_VERSION=r383902
USE_CUSTOM_CLANG=false
USE_LLVM=false

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=none

ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=kernel-4.14

ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=false

# Safe SUSFS profile for 4.14/non-GKI: no SUS_MOUNT / TRY_UMOUNT / AUTO_ADD_*.
EXTRA_DEFCONFIG=CONFIG_KSU_SUSFS_SUS_MOUNT=n CONFIG_KSU_SUSFS_TRY_UMOUNT=n CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=n CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=n CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=n

USE_CUSTOM_ANYKERNEL3=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true