From ee83a14546bd1f4722a0c049876b46a657e05848 Mon Sep 17 00:00:00 2001
From: Artemis1447 <Artemis1447@users.noreply.github.com>
Date: Fri, 27 Nov 2026 01:09:05 +0100
Subject: [PATCH] ci: pin Node 24 actions and limit V19 artifacts to 14 days

---
 .github/workflows/build-kernel.yml | 23 +++++++++++++----------
 .github/workflows/ci.yml           |  2 +-
 2 files changed, 14 insertions(+), 11 deletions(-)

diff --git a/.github/workflows/build-kernel.yml b/.github/workflows/build-kernel.yml
index 9bbe9f7..5247baa 100644
--- a/.github/workflows/build-kernel.yml
+++ b/.github/workflows/build-kernel.yml
@@ -125,7 +125,7 @@ jobs:
       IN_EXTRA_DEFCONFIG: ${{ inputs.extra_defconfig }}
 
     steps:
-      - uses: actions/checkout@v4
+      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6, Node 24
 
       - name: Resolve configuration
         run: bash scripts/config.sh
@@ -196,7 +196,7 @@ jobs:
 
       - name: Set up ccache
         if: env.ENABLE_CCACHE == 'true'
-        uses: hendrikmuhs/ccache-action@v1.2
+        uses: hendrikmuhs/ccache-action@14f432aed9074b19bfba92ad341af1f8784c9aac # v1.2, Node 24
         with:
           key: kernel-${{ env.DEVICE }}-${{ env.KSU_VARIANT }}-${{ env.KERNEL_VERSION }}
           max-size: 2G
@@ -278,37 +278,40 @@ jobs:
           } >> "$GITHUB_OUTPUT"
 
       - name: Upload kernel image
-        uses: actions/upload-artifact@v4
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7, Node 24
         with:
+          retention-days: 14
           name: ${{ env.KERNEL_IMAGE_NAME }}${{ env.LOCALVERSION }}${{ env.UPLOADNAME }}-${{ env.DEVICE }}-${{ env.BUILD_TIME }}
           path: kernel_workspace/android-kernel/out/arch/${{ env.ARCH }}/boot/${{ env.KERNEL_IMAGE_NAME }}
           if-no-files-found: error
 
       - name: Upload pvrsrvkm ABI diagnostics
         if: always() && env.CHECK_PVRSRVKM_ABI == 'true'
-        uses: actions/upload-artifact@v4
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
         with:
+          retention-days: 14
           name: pvrsrvkm-ABI-${{ env.DEVICE }}-${{ env.BUILD_TIME }}
           path: kernel_workspace/abi-diagnostics/*
           if-no-files-found: warn
 
       - name: Upload AnyKernel3
-        uses: actions/upload-artifact@v4
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
         with:
+          retention-days: 14
           name: AnyKernel3${{ env.LOCALVERSION }}${{ env.UPLOADNAME }}-${{ env.DEVICE }}-${{ env.BUILD_TIME }}
           path: kernel_workspace/AnyKernel3/*
           if-no-files-found: error
 
       - name: Upload DTBO image
         if: env.CHECK_DTBO_IS_OK == 'true'
-        uses: actions/upload-artifact@v4
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
         with:
           name: dtbo-${{ env.DEVICE }}-${{ env.BUILD_TIME }}
           path: kernel_workspace/android-kernel/out/arch/${{ env.ARCH }}/boot/dtbo.img
 
       - name: Upload boot image
         if: env.MAKE_BOOT_IMAGE_IS_OK == 'true'
-        uses: actions/upload-artifact@v4
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
         with:
           name: boot${{ env.LOCALVERSION }}${{ env.UPLOADNAME }}-${{ env.DEVICE }}-${{ env.BUILD_TIME }}
           path: kernel_workspace/boot.img
@@ -318,13 +321,13 @@ jobs:
   release:
     name: Publish release
     needs: build
-    if: inputs.publish_release
+    if: inputs.publish_release && github.ref_name != 'v19-extreme'
     runs-on: ubuntu-latest
     permissions:
       contents: write
     steps:
       - name: Download artifacts
-        uses: actions/download-artifact@v4
+        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8, Node 24
         with:
           path: artifacts
           merge-multiple: false
@@ -344,7 +347,7 @@ jobs:
           ls -la release/
 
       - name: Create release
-        uses: softprops/action-gh-release@72f2c25fcb47643c292f7107632f7a47c1df5cd8 # v2.3.2
+        uses: softprops/action-gh-release@40c2ca6ddd77ba2a30bbea8f67409c0f76868d67 # v3, Node 24
         with:
           tag_name: ${{ needs.build.outputs.device }}-${{ needs.build.outputs.build_time }}
           name: ${{ needs.build.outputs.device }} · ${{ needs.build.outputs.ksu_name }} · ${{ needs.build.outputs.build_time }}
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 5ec7476..dfd8239 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -15,7 +15,7 @@ jobs:
     name: Lint scripts and workflows
     runs-on: ubuntu-latest
     steps:
-      - uses: actions/checkout@v4
+      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6, Node 24
 
       - name: ShellCheck
         run: |
