 	return 0;
 }
 
+int susfs_add_sus_path(struct st_susfs_sus_path* __user user_info) {
+	struct st_susfs_sus_path info;
+
+	if (copy_from_user(&info, user_info, sizeof(info))) {
+		SUSFS_LOGE("failed copying from userspace\n");
+		return 1;
+	}
+
+	return susfs_add_sus_path_info(&info);
+}
+
+int susfs_add_sus_path_sukisu(void __user *user_info) {
+	struct {
+		char target_pathname[SUSFS_MAX_LEN_PATHNAME];
+		int err;
+	} cmd;
+	struct st_susfs_sus_path info = { 0 };
+
+	if (copy_from_user(&cmd, user_info, sizeof(cmd)))
+		return -EFAULT;
+
+	if (!memchr(cmd.target_pathname, '\0', sizeof(cmd.target_pathname))) {
+		cmd.err = -ENAMETOOLONG;
+	} else {
+		memcpy(info.target_pathname, cmd.target_pathname,
+		       sizeof(info.target_pathname));
+		cmd.err = susfs_add_sus_path_info(&info);
+	}
+
+	if (copy_to_user((char __user *)user_info + sizeof(cmd.target_pathname),
+			 &cmd.err, sizeof(cmd.err)))
+		return -EFAULT;
+
+	return 0;
+}
