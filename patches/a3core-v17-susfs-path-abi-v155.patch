+/*
+ * ---- V17: SUSFS v1.5.5 / Linux 4.14 compatibility --------------------
+ *
+ * Newer SUSFS exposes per-process markers (TIF_PROC_*) and a deferred work
+ * item that do not exist in v1.5.5. The KSU side guards those call sites on
+ * the SUSFS_V155_LACKS_* markers below so the gap is explicit instead of a
+ * stub. The "hidden from this task" condition is carried by a thread flag
+ * (TIF_PROC_UMOUNTED) instead of a task_struct field, so the kernel keeps the
+ * stock module ABI.
+ */
+#define SUSFS_V155_LACKS_NO_SU 1
+#define SUSFS_V155_LACKS_UMOUNTED_FOR_ZYGOTE_NEXT 1
+#define SUSFS_V155_LACKS_EXTRA_WORKS 1
+#define SUSFS_V155_LACKS_SUS_TYPE 1
+
+/*
+ * The a3core vendor tree calls ksu_handle_stat()/ksu_handle_faccessat() with
+ * `const char __user **`, while SukiSU's CONFIG_KSU_SUSFS branch declares them
+ * with `struct filename **`. Without this marker the early initramfs unpack
+ * dereferences a user pointer as struct filename and panics at boot.
+ */
+#define SUSFS_V155_A3CORE_USER_PTR_HOOKS 1
+
+/*
+ * V17 keeps SUSFS' per-task marker out of task_struct. The extra field would
+ * change the struct layout and therefore every MODVERSIONS CRC that reaches
+ * it, breaking the stock vendor modules. A thread flag carries the same
+ * per-task state with no layout change -- the same approach newer SUSFS uses.
+ */
+#define TIF_PROC_UMOUNTED 33
+
+static inline bool susfs_is_current_proc_umounted(void)
+{
+	return test_thread_flag(TIF_PROC_UMOUNTED);
+}
+
+static inline void susfs_set_current_proc_umounted(void)
+{
+	set_thread_flag(TIF_PROC_UMOUNTED);
+}
+
+/* Exact ports of the newer string helpers; adb_root.c uses both. */
+static inline bool susfs_starts_with(const char *str, const char *prefix)
+{
+	while (*prefix) {
+		if (*str++ != *prefix++)
+			return false;
+	}
+	return true;
+}
+
+static inline bool susfs_ends_with(const char *str, const char *suffix)
+{
+	size_t str_len, suffix_len;
+
+	if (!str || !suffix)
+		return false;
+
+	str_len = strlen(str);
+	suffix_len = strlen(suffix);
+	if (suffix_len > str_len)
+		return false;
+
+	return !strcmp(str + str_len - suffix_len, suffix);
+}
