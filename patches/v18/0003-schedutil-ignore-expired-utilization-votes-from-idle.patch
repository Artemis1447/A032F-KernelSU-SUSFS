From fcbcdd8b42f63a33710a3f9d8f7363ea52651edc Mon Sep 17 00:00:00 2001
From: Artemis1447 <Artemis1447@users.noreply.github.com>
Date: Fri, 27 Nov 2026 00:11:34 +0100
Subject: [PATCH 3/3] schedutil: ignore expired utilization votes from idle
 policy siblings

Both SC9863A clusters share their frequency policy. A thread migrating away can leave its utilization or deadline vote in both the scheduler decision and the vendor slow-switch worker. Apply the one-tick expiry to both paths and require the sibling to be idle so a busy tickless CPU retains its vote. Use the triggering scheduler timestamp in the deferred path, allowing samples newer than that timestamp.
---
 kernel/sched/cpufreq_schedutil.c | 30 +++++++++++++++++-------------
 1 file changed, 17 insertions(+), 13 deletions(-)

diff --git a/kernel/sched/cpufreq_schedutil.c b/kernel/sched/cpufreq_schedutil.c
index 089167aa545..ded7b812326 100644
--- a/kernel/sched/cpufreq_schedutil.c
+++ b/kernel/sched/cpufreq_schedutil.c
@@ -202,7 +202,7 @@ static void sugov_update_commit(struct sugov_policy *sg_policy, u64 time,
 	if (!data)
 		goto unlock;
 
-	sg_policy->commit_time = time;
+	WRITE_ONCE(sg_policy->commit_time, time);
 
 	if (policy->fast_switch_enabled) {
 		next_freq = cpufreq_driver_fast_switch(policy, next_freq);
@@ -423,7 +423,7 @@ static void sugov_update_single(struct update_util_data *hook, u64 time,
 	sg_cpu->flags = flags;
 
 	sugov_set_iowait_boost(sg_cpu, time, flags);
-	sg_cpu->last_update = time;
+	WRITE_ONCE(sg_cpu->last_update, time);
 
 	if (!sugov_should_update_freq(sg_policy, time, NULL)) {
 		sugov_performance_htimer_start(sg_policy, time);
@@ -458,9 +458,15 @@ static void sugov_update_single(struct update_util_data *hook, u64 time,
 	raw_spin_unlock(&sg_policy->update_lock);
 }
 
+static bool sugov_sample_expired(struct sugov_cpu *sg_cpu, u64 time)
+{
+	return (s64)(time - READ_ONCE(sg_cpu->last_update)) > TICK_NSEC;
+}
+
 static unsigned int sugov_next_freq_policy(struct sugov_policy *sg_policy)
 {
 	struct cpufreq_policy *policy = sg_policy->policy;
+	u64 time = READ_ONCE(sg_policy->commit_time);
 	unsigned long util = 0, max = 1;
 	unsigned int j;
 
@@ -468,6 +474,10 @@ static unsigned int sugov_next_freq_policy(struct sugov_policy *sg_policy)
 		struct sugov_cpu *j_sg_cpu = &per_cpu(sugov_cpu, j);
 		unsigned long j_util, j_max;
 
+		/* The deferred vote must not bring an idle sibling back in. */
+		if (sugov_sample_expired(j_sg_cpu, time) && idle_cpu(j))
+			continue;
+
 		if (j_sg_cpu->flags & SCHED_CPUFREQ_DL)
 			return policy->cpuinfo.max_freq;
 
@@ -493,19 +503,13 @@ static unsigned int sugov_next_freq_shared(struct sugov_cpu *sg_cpu, u64 time)
 	for_each_cpu(j, policy->cpus) {
 		struct sugov_cpu *j_sg_cpu = &per_cpu(sugov_cpu, j);
 		unsigned long j_util, j_max;
-		s64 delta_ns;
 
-		/*
-		 * If the CPU utilization was last updated before the previous
-		 * frequency update and the time elapsed between the last update
-		 * of the CPU utilization and the last frequency update is long
-		 * enough, don't take the CPU into account as it probably is
-		 * idle now (and clear iowait_boost for it).
-		 */
-		delta_ns = time - j_sg_cpu->last_update;
-		if (delta_ns > TICK_NSEC) {
+		if (sugov_sample_expired(j_sg_cpu, time)) {
 			j_sg_cpu->iowait_boost = 0;
 			j_sg_cpu->iowait_boost_pending = false;
+			/* Keep a busy CPU's vote even when it has not ticked. */
+			if (idle_cpu(j))
+				continue;
 		}
 		if (j_sg_cpu->flags & SCHED_CPUFREQ_DL)
 			return policy->cpuinfo.max_freq;
@@ -541,7 +545,7 @@ static void sugov_update_shared(struct update_util_data *hook, u64 time,
 	sg_cpu->flags = flags;
 
 	sugov_set_iowait_boost(sg_cpu, time, flags);
-	sg_cpu->last_update = time;
+	WRITE_ONCE(sg_cpu->last_update, time);
 
 	if (sugov_should_update_freq(sg_policy, time, &within_limit)) {
 		if (flags & SCHED_CPUFREQ_DL)
