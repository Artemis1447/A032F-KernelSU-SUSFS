diff --git a/kernel/reboot.c b/kernel/reboot.c
index ecf8be6..526a9b0 100644
--- a/kernel/reboot.c
+++ b/kernel/reboot.c
@@ -274,6 +274,15 @@ EXPORT_SYMBOL_GPL(kernel_power_off);
 
 static DEFINE_MUTEX(reboot_mutex);
 
+#if defined(CONFIG_KSU) && defined(CONFIG_KSU_SUSFS)
+/*
+ * The stock a3core 4.14 tree has no KSU reboot hook. ksud installs the
+ * manager/driver fd through the KSU_INSTALL_MAGIC reboot-magic request.
+ */
+extern int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
+				 void __user **arg);
+#endif
+
 /*
  * Reboot system call: for obvious reasons only root may call it,
  * and even root needs to set up some magic numbers in the registers
@@ -289,6 +298,10 @@ SYSCALL_DEFINE4(reboot, int, magic1, int, magic2, unsigned int, cmd,
 	char buffer[256];
 	int ret = 0;
 
+#if defined(CONFIG_KSU) && defined(CONFIG_KSU_SUSFS)
+	ksu_handle_sys_reboot(magic1, magic2, cmd, &arg);
+#endif
+
 	/* We only trust the superuser with rebooting the system. */
 	if (!ns_capable(pid_ns->user_ns, CAP_SYS_BOOT))
 		return -EPERM;
