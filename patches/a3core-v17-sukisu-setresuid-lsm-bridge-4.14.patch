+#ifdef CONFIG_KSU_SUSFS
+/*
+ * SUSFS replaces the legacy task_fix_setuid handler with
+ * ksu_handle_setresuid(), which upstream calls from the setresuid syscall
+ * implementation. This Linux 4.14 tree has no such call site, so bridge it
+ * through the standard LSM hook instead.
+ *
+ * security_task_fix_setuid() runs before commit_creds(), so current_uid() is
+ * still 0 and the current SELinux SID is still the zygote's -- exactly the
+ * context ksu_handle_setresuid() expects.
+ */
+static int ksu_susfs_task_fix_setuid(struct cred *new, const struct cred *old, int flags)
+{
+    if (!new || !old)
+        return 0;
+
+    return ksu_handle_setresuid(new->uid.val, new->euid.val, new->suid.val);
+}
+#endif
+
 static struct security_hook_list ksu_hooks[] = {
 #if LINUX_VERSION_CODE < KERNEL_VERSION(4, 10, 0) || defined(CONFIG_IS_HW_HISI) ||                                     \
     defined(CONFIG_KSU_ALLOWLIST_WORKAROUND)
     LSM_HOOK_INIT(key_permission, ksu_key_permission),
 #endif
-#ifndef CONFIG_KSU_SUSFS
+#ifdef CONFIG_KSU_SUSFS
+    LSM_HOOK_INIT(task_fix_setuid, ksu_susfs_task_fix_setuid),
