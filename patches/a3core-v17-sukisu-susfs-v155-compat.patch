diff --git a/kernel/supercall/susfs_compat_4_14.h b/kernel/supercall/susfs_compat_4_14.h
new file mode 100644
--- /dev/null
+++ b/kernel/supercall/susfs_compat_4_14.h
@@ -0,0 +1,153 @@
+#ifndef KSU_SUSFS_COMPAT_4_14_H
+#define KSU_SUSFS_COMPAT_4_14_H
+
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/susfs.h>
+#include <linux/uaccess.h>
+
+#ifndef SUSFS_MAGIC
+#define SUSFS_MAGIC 0xFAFAFAFA
+#endif
+
+#define CMD_SUSFS_ADD_SUS_PATH_LOOP 0x00055553
+#define CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING 0x00060010
+#define SUKISU_SUSFS_VERSION_SIZE 16
+#define SUKISU_SUSFS_FEATURES_SIZE 8192
+#define SUKISU_SUSFS_VARIANT_SIZE 16
+#define SUKISU_SUSFS_CMDLINE_SIZE 8192
+
+struct sukisu_susfs_version_cmd {
+    char version[SUKISU_SUSFS_VERSION_SIZE];
+    s32 err;
+};
+
+struct sukisu_susfs_features_cmd {
+    char features[SUKISU_SUSFS_FEATURES_SIZE];
+    s32 err;
+};
+
+struct sukisu_susfs_variant_cmd {
+    char variant[SUKISU_SUSFS_VARIANT_SIZE];
+    s32 err;
+};
+
+struct sukisu_susfs_log_cmd {
+    u32 enabled;
+    s32 err;
+};
+
+static inline int susfs_sukisu_unsupported(void)
+{
+    return -EOPNOTSUPP;
+}
+
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+static inline int susfs_sukisu_set_uname(void __user *arg)
+{
+    int err;
+
+    err = susfs_set_uname((struct st_susfs_uname __user *)arg);
+    return copy_to_user((char __user *)arg +
+                        2 * (__NEW_UTS_LEN + 1), &err, sizeof(err))
+               ? -EFAULT
+               : 0;
+}
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+static inline int susfs_sukisu_enable_log(void __user *arg)
+{
+    struct sukisu_susfs_log_cmd cmd;
+
+    if (copy_from_user(&cmd, arg, sizeof(cmd)))
+        return -EFAULT;
+    susfs_set_log(cmd.enabled != 0);
+    cmd.err = 0;
+    return copy_to_user(arg, &cmd, sizeof(cmd)) ? -EFAULT : 0;
+}
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+static inline int susfs_sukisu_set_cmdline(void __user *arg)
+{
+    char *probe;
+    int err;
+
+    probe = kmalloc(SUSFS_FAKE_CMDLINE_OR_BOOTCONFIG_SIZE, GFP_KERNEL);
+    if (!probe)
+        return -ENOMEM;
+    if (copy_from_user(probe, arg, SUSFS_FAKE_CMDLINE_OR_BOOTCONFIG_SIZE)) {
+        kfree(probe);
+        return -EFAULT;
+    }
+    if (!memchr(probe, '\0', SUSFS_FAKE_CMDLINE_OR_BOOTCONFIG_SIZE))
+        err = -ENAMETOOLONG;
+    else
+        err = susfs_set_cmdline_or_bootconfig((char __user *)arg);
+    kfree(probe);
+
+    return copy_to_user((char __user *)arg + SUKISU_SUSFS_CMDLINE_SIZE,
+                        &err, sizeof(err)) ? -EFAULT : 0;
+}
+#endif
+
+static inline int susfs_sukisu_show_version(void __user *arg)
+{
+    struct sukisu_susfs_version_cmd cmd = { 0 };
+
+    strlcpy(cmd.version, SUSFS_VERSION, sizeof(cmd.version));
+    return copy_to_user(arg, &cmd, sizeof(cmd)) ? -EFAULT : 0;
+}
+
+static inline int susfs_sukisu_show_variant(void __user *arg)
+{
+    struct sukisu_susfs_variant_cmd cmd = { 0 };
+
+    strlcpy(cmd.variant, SUSFS_VARIANT, sizeof(cmd.variant));
+    return copy_to_user(arg, &cmd, sizeof(cmd)) ? -EFAULT : 0;
+}
+
+static inline void susfs_sukisu_append_feature(char *buf, size_t size,
+                                               const char *name)
+{
+    size_t len = strlen(buf);
+
+    if (len < size)
+        scnprintf(buf + len, size - len, "%s%s", len ? "\n" : "", name);
+}
+
+static inline int susfs_sukisu_show_features(void __user *arg)
+{
+    struct sukisu_susfs_features_cmd *cmd;
+    int ret;
+
+    cmd = kzalloc(sizeof(*cmd), GFP_KERNEL);
+    if (!cmd)
+        return -ENOMEM;
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+    susfs_sukisu_append_feature(cmd->features, sizeof(cmd->features), "SUS_PATH");
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+    susfs_sukisu_append_feature(cmd->features, sizeof(cmd->features), "SPOOF_UNAME");
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+    susfs_sukisu_append_feature(cmd->features, sizeof(cmd->features), "ENABLE_LOG");
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+    susfs_sukisu_append_feature(cmd->features, sizeof(cmd->features),
+                                "SPOOF_CMDLINE_OR_BOOTCONFIG");
+#endif
+#ifdef CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+    susfs_sukisu_append_feature(cmd->features, sizeof(cmd->features),
+                                "HIDE_KSU_SUSFS_SYMBOLS");
+#endif
+    cmd->err = 0;
+    ret = copy_to_user(arg, cmd, sizeof(*cmd)) ? -EFAULT : 0;
+    kfree(cmd);
+    return ret;
+}
+
+#endif
